# Development (Vite proxy to API_Backend on localhost:5044)
VITE_API_BASE_URL=/api
# Leave empty in local dev so SignalR uses the Vite /hubs proxy (same-origin, no CORS).
VITE_HUB_BASE_URL=

# Production — set your deployed API host
# VITE_API_BASE_URL=https://api.yourdomain.com/api
# VITE_HUB_BASE_URL=https://api.yourdomain.com
